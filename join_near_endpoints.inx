<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">

	<name>Join Near Endpoints</name>
	<id>maps_edge.join_near_endpoints</id>

	<param name="tolerance" type="float" min="0.001" max="100" precision="3" gui-text="Join endpoints closer than (mm):">0.3</param>

	<effect needs-live-preview="false">
		<object-type>path</object-type>
		<effects-menu>
			<submenu name="Map's Edge Tools" translatable="no">
				<submenu name="General" translatable="no">
					<submenu name="Paths" translatable="no" />
				</submenu>
			</submenu>
		</effects-menu>
	</effect>

	<script>
		<command location="inx" interpreter="python">join_near_endpoints.py</command>
	</script>

</inkscape-extension>
